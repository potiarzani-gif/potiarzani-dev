Algoritmo "hogwarts_house_function_IF_WHILE"
var
    DRINK, SPOT, SUBJECT, HEX: INTEIRO
    House: Caractere
Funcao SortingHat(D, Sp, Sub, Hx: Inteiro):caractere
Inicio
    se (D = 1) e (Sp = 1) e (Sub = 3) e (Hx = 1) entao
        Retorne "HUFFLEPUFF!"
    senao
        se (D = 2) e (Sp = 2) e (Sub = 1) e (Hx = 3) entao
        Retorne "RAVENCLAW!"
        senao
            se (D = 3) e (Sp = 4) e (Sub = 4) e (Hx = 2) entao
            Retorne "GRIFFYNDOR!"
            senao
                se (D = 4) e (Sp = 3) e (Sub = 2) e (Hx = 4) entao
                Retorne "SLYTHERIN!"
                Senao 
                Retorne " INVALID!"
                fimse
            fimse
        fimse
    fimse
FimFuncao
inicio
