Algoritmo "sorting_hat_switch_case"
var
    DRINK, SPOT, SUBJECT, HEX: INTEIRO
    House: Caractere
Funcao SortingHat(D: Inteiro, Sp: Inteiro, Sbj: Inteiro, Hx: Inteiro): caractere
var
