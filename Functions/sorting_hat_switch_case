        Caso 3442
            Retorne "GRIFFYNDOR!"
        Caso 4324
            Retorne "SLYTHERIN!"
        outrocaso
            Retorne "Maybe you are a muggle!"
        FimEscolha
FimFuncao
inicio
    EscrevaL ("-------  VIRTUAL SORTING HAT --------")
    EscrevaL ("Please, answer following questions honestly!")
    EscrevaL ("What's your favorite drink? =>")
    Escreva ("[1] Gillywater [2] Pumpkin Juice [3] Butterbeer [4] Firewhisky =>")
    Leia (DRINK)
