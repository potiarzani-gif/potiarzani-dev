Algoritmo "parameters_sum"

Var
   X, Y: Inteiro
Procedimento Soma (A, B: Inteiro)
Inicio
      EscrevaL ("Value entered: ", A)
      EscrevaL ("Value entered: ", B)
      EscrevaL ("The sum between both is: ", A + B)
FimProcedimento
Inicio
      X <- 5
      Y <- 3
      Soma (X, Y)


Fimalgoritmo