Algoritmo "double"

Var
   X, Y: Inteiro
Procedimento Calculate (var A: Inteiro; B: Inteiro)
Inicio
 A <- A * 2
 B <- B * 2
 EscrevaL ("A: ", A)
 EscrevaL ("B: ", B)

FimProcedimento
Inicio
      X <- 10
      Y <- 10
      Calculate (X, Y)
      EscrevaL ("X: ", X)
      EscrevaL ("Y: ", Y)

Fimalgoritmo