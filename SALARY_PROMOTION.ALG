Algoritmo "Salary_promotion"

Var
   S, Increase: Real

Inicio
       Escreva ("Please enter your current monthly salary: $")
       Leia (S)
       Increase <- (S * 0.15) + S
       Escreval ("Congratulations! You have been promoted and received a 15% raise.")
       Escreva  ("Your new monthly compensation is $", Increase:5:2)

Fimalgoritmo